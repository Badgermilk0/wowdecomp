# MODIFIED: built-in AwesomeCVar and Flash. Run as a script (cmake -P) at build time: writes OUT, a C++ file holding
# every file under ROOT (Interface/) as a byte array, for AwesomeEmbeddedUi.cpp. Paths are relative to ROOT with
# backslashes, as a .toc names them ("AwesomeCVar\Locales\enUS.lua").

file(GLOB_RECURSE files RELATIVE "${ROOT}" "${ROOT}/*.toc" "${ROOT}/*.lua" "${ROOT}/*.xml")
list(SORT files)

set(body "// Generated by WoW/Source/Awesome/EmbedInterface.cmake from WoW/Source/Awesome/Interface; do not edit\n")
string(APPEND body "#include <cstddef>\n#include \"WoW/Source/Awesome/AwesomeEmbeddedUi.h\"\n\n")

set(index 0)
set(table "")

foreach(file IN LISTS files)
    file(READ "${ROOT}/${file}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    math(EXPR size "${hexLength} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const unsigned char s_file${index}[] = { ${bytes} 0x00 };\n")

    string(REPLACE "/" "\\\\" path "${file}")
    string(APPEND table "    { \"${path}\", s_file${index}, ${size} },\n")
    math(EXPR index "${index} + 1")
endforeach()

string(APPEND body "\nconst AwesomeEmbeddedFile g_awesomeEmbeddedFiles[] = {\n${table}};\n\n")
string(APPEND body "const size_t g_awesomeEmbeddedFileCount = ${index};\n")

# unchanged content keeps the timestamp, so nothing recompiles
set(old "")

if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()

if(NOT old STREQUAL body)
    file(WRITE "${OUT}" "${body}")
endif()
